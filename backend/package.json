{
    "name": "hiveborn-backend",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx src/db/migrate.ts",
        "db:studio": "drizzle-kit studio",
        "test": "tsx --test tests/*.test.ts"
    },
    "dependencies": {
        "@fastify/cors": "^11.2.0",
        "@fastify/rate-limit": "^10.3.0",
        "@fastify/websocket": "^11.2.0",
        "@workos-inc/node": "^9.3.0",
        "better-sqlite3": "^12.10.0",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "fastify": "^5.12.5",
        "nanoid": "^5.1.11",
        "posthog-node": "^5.54.1",
        "unique-names-generator": "^4.7.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^25.9.1",
        "drizzle-kit": "^0.31.10",
        "pino-pretty": "^13.1.3",
        "tsx": "^4.22.3",
        "typescript": "~6.0.3"
    },
    "engines": {
        "node": ">=24.22.1 <25"
    },
    "packageManager": "pnpm@10.33.0",
    "pnpm": {
        "onlyBuiltDependencies": [
            "better-sqlite3",
            "esbuild"
        ],
        "overrides": {
            "esbuild@0": "0.25.0",
            "fast-uri@4": "4.1.5",
            "fast-uri@3": "3.1.8",
            "fastify@5": "5.12.5",
            "fast-copy@4": "4.1.0"
        }
    }
}
